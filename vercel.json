{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "installCommand": "npm install --no-audit --no-fund",
  "headers": [
    {
      "source": "/(app\\.[0-9a-f]+\\.(?:js|css))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/ai.js": {
      "maxDuration": 60
    }
  }
}
